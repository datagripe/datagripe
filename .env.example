# DataGripe server configuration.
#
# Zero-config default: with no APP_DATABASE_URL the server starts an
# embedded PostgreSQL cluster (data in ./data/pg), migrates it
# automatically, generates local secrets (./data/datagripe.secrets.json),
# and runs with AUTH_DISABLED=true — direct in, no accounts.
#
# Everything below is OPTIONAL and only needed for a shared/external
# PostgreSQL deployment like a team server or this repository's compose
# setup.

NODE_ENV=development
PORT=3001
# The interface to listen on. Every one by default; 127.0.0.1 answers
# only this machine, which is what `datagripe personal` sets.
# HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# --- external mode -------------------------------------------------------
# Setting APP_DATABASE_URL selects external mode: the given PostgreSQL is
# used as-is, both secrets are REQUIRED, auth defaults to enabled, and
# migrations run via `bun run db:migrate` (not automatically).
APP_DATABASE_URL=postgres://datagripe:datagripe@localhost:5432/datagripe
CONNECTION_ENCRYPTION_KEY=replace-with-a-generated-development-key
SESSION_SECRET=replace-with-a-generated-development-secret

# Force a mode regardless of APP_DATABASE_URL presence:
# DATABASE_MODE=embedded
# DATABASE_MODE=external

# Embedded cluster location/port (0 = auto):
# EMBEDDED_PG_DATA_DIR=./data/pg
# EMBEDDED_PG_PORT=0

# Only read by the packaged launcher — `bunx @datagripe/cli` and the
# container image, which have no checkout to keep ./data in. It sets
# EMBEDDED_PG_DATA_DIR and GIT_REPOS_DIR under it, and the generated
# secrets file sits beside them. Defaults to ~/.local/share/datagripe,
# and to /data in the image.
# DATAGRIPE_DATA_DIR=

# Force account auth on/off regardless of mode default:
# AUTH_DISABLED=true
# AUTH_DISABLED=false

# Serve the built web app from the server (single-binary / desktop):
# WEB_STATIC_DIR=./apps/web/dist

# Where the migrations live, when they are not in a checkout (the
# packaged desktop app ships them beside the bundled server):
# MIGRATIONS_DIR=./apps/server/migrations

QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=10000
QUERY_MAX_BYTES=25000000
MAX_CONCURRENT_QUERIES_PER_USER=3
# Optional: predefined connections file (default ./connections.json, gitignored)
# CONNECTIONS_FILE=./connections.json
# Allow account signup after the first (bootstrap) account exists
ALLOW_SIGNUP=false

# --- Security keys (FIDO2 / WebAuthn) ------------------------------------
# A key is an alternative to the password, for both signup and sign-in, and
# an account may register as many as it likes. Sign-in is usernameless: the
# key names the account, so there is no email to type. Nothing to switch on
# — these only tune where the credentials are scoped.
#
# The relying-party id a credential is bound to. Defaults to WEB_ORIGIN's
# hostname; set it to a parent domain when the app answers on several
# subdomains and one key should work across all of them.
# WEBAUTHN_RP_ID=datagripe.example.com
# The name the key shows while asking for a touch.
# WEBAUTHN_RP_NAME=DataGripe
# Extra origins a ceremony may come from, comma separated. WEB_ORIGIN is
# always accepted; this is for the second hostname a proxy answers on.
# WEBAUTHN_EXTRA_ORIGINS=https://datagripe.example.com

# --- Which sign-in methods exist ------------------------------------------
# Each is independently switchable, so a deployment can be locked to one
# of them. Off means the routes are absent, not a form that refuses, and
# the sign-in screen only renders what exists. Turning off the last way
# in is refused at startup.
# PASSWORD_AUTH_DISABLED=true
# PASSKEY_AUTH_DISABLED=true

# --- Google sign-in (OIDC) -----------------------------------------------
# Off until both of these are set; setting only one is an error rather
# than a silent no-op. The OAuth client is created in Google Cloud
# console → APIs & Services → Credentials, as a "Web application".
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# The redirect URI registered with that client. Defaults to WEB_ORIGIN +
# /api/auth/google/callback, which is right whenever the browser reaches
# the API on the origin it loads the app from.
# GOOGLE_REDIRECT_URI=https://datagripe.example.com/api/auth/google/callback
# Comma-separated Google Workspace domains allowed to sign in (the `hd`
# claim). Empty means any Google account — which, with ALLOW_SIGNUP=true,
# means anyone on the internet.
# GOOGLE_ALLOWED_DOMAINS=example.com

# --- The host filesystem, and git ----------------------------------------
# All off or restricted by default, and each is a separate decision.
#
# Turns off EVERY host-filesystem feature: domain export and import,
# datasource paths, git datasources. What a hosted, multi-tenant
# deployment sets — there, the person pressing the button does not own
# the disk.
# HOST_FS_DISABLED=false
# Optional colon-separated allowlist of absolute directories the server
# may read and write. Empty means no allowlist, because the directory is
# already named per datasource.
# HOST_FS_ROOTS=/srv/checkouts:/srv/exports
# Every git feature: the domain export's commit controls and git
# datasources. Off means absent, not disabled-with-a-tooltip.
# GIT_ENABLED=false
# One clone directory per datasource. Defaults beside the data directory.
# GIT_REPOS_DIR=./data/repos
# Every git invocation is killed at this; clone gets its own budget,
# because a big repository is not a hung one.
# GIT_TIMEOUT_MS=60000
# GIT_CLONE_TIMEOUT_MS=600000
# Lets a repository's .datagripe/run.yaml declare commands DataGripe may
# run. Its own switch on purpose: every other git feature reads and
# writes files, and this one executes a program somebody else wrote.
# Nothing runs until a person approves the list, and any change to it
# needs a fresh approval.
# REPO_COMMANDS_ENABLED=false
# Used when a command declares no timeoutSeconds of its own, and the hard
# ceiling per run whatever it asked for.
# REPO_COMMAND_DEFAULT_TIMEOUT_MS=120000
# REPO_COMMAND_TIMEOUT_MS=600000

# --- More server-enforced limits -----------------------------------------
# Per-table cap for a domain export with includeData. Exceeding it fails
# that table and says so, rather than writing a file that looks complete.
# DOMAIN_EXPORT_MAX_DATA_ROWS=10000
# Access-report ceiling; above it the request asks for a filter instead
# of timing out.
# ACCESS_REPORT_MAX_CELLS=250000

# --- Older names, still read ---------------------------------------------
# Renamed when the features outgrew the domain export. The old name still
# works and the new one wins when both are set.
# DOMAIN_EXPORT_ROOTS -> HOST_FS_ROOTS
# DOMAIN_EXPORT_GIT -> GIT_ENABLED
# DOMAIN_GIT_TIMEOUT_MS -> GIT_TIMEOUT_MS

# Comma-separated target hosts allowed despite SSRF private-range blocks
# TARGET_HOST_ALLOWLIST=localhost,127.0.0.1,::1
# Disable SSRF target-host blocking entirely. Only for trusted-network
# deployments: the server will connect to any host, including private
# ranges, loopback, and cloud metadata endpoints.
# SSRF_DISABLED=false

# --- Updates (docs/spec/updates.md) --------------------------------------
# The status bar shows the version and whether anything newer exists. It
# asks the release feed when a project is opened, and the server holds
# the answer for ten minutes — no interval, no background thread. Remove
# it outright on a deployment that cannot reach the internet:
# UPDATE_CHECK_DISABLED=false
#
# Which shape this is, for the upgrade advice the menu gives. The desktop
# shell, the CLI launcher and the container image each set it; Kubernetes
# is detected and wins over it. Setting it by hand only changes the advice.
# DATAGRIPE_SHAPE=container
#
# Whether ending the process brings a new one back. True in Kubernetes by
# default and false everywhere else — with imagePullPolicy: Always a
# restart IS the upgrade, so the menu offers an owner a restart button.
# Set it for a compose stack or a systemd unit that restarts.
# RESTART_TO_UPDATE=true

# --- MCP (docs/spec/mcp.md) ----------------------------------------------
# One endpoint per project at POST /mcp/<projectId>, so an agent can read
# the project's own documentation and query its datasources. This is the
# deployment's kill switch and it defaults to ON: the opt-in is per
# project, off until an owner turns it on, and read-only until they say
# otherwise. Off here means the route and the panel are both absent.
# MCP_ENABLED=true
# What the panel tells people to point their client at. Defaults to
# WEB_ORIGIN, because the endpoint is the same process on the same origin
# as the app. Set it only when MCP answers on a different hostname.
# MCP_PUBLIC_URL=https://datagripe.example.com
# Caps for one tool call. The consumer is a context window, not a grid.
# MCP_MAX_ROWS=200
# MCP_MAX_BYTES=1000000
# MCP_READ_MAX_BYTES=65536
# MCP_INSTRUCTIONS_MAX_BYTES=16384
