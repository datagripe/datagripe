# Copy to deploy/.env — compose reads it from beside the compose file.
#
#   cp deploy/.env.example deploy/.env
#
# The three secrets have no defaults on purpose: compose refuses to start
# without them rather than bringing up a deployment with a password
# somebody read in a public repository.

# Hex, not base64: this one is interpolated into a connection URL, and a
# `/` or `+` in it ends the password early.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# These two are read as-is, so anything goes.
#   openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=
SESSION_SECRET=

# The origin browsers use, and the port it is published on. These two go
# together: publishing on 8080 without saying so here gives an app that
# loads and then fails its WebSocket upgrade on the origin check.
# WEB_ORIGIN=http://localhost:3000
# DATAGRIPE_PORT=3000

# Only once WEB_ORIGIN is https — it puts `Secure` on the session cookie.
# NODE_ENV=production

# The first account is always allowed to sign up. This is about the ones
# after it.
# ALLOW_SIGNUP=false

# Pin the image instead of tracking latest.
# DATAGRIPE_VERSION=0.0.5
